# ai-memory instance secrets — chmod 600, never commit. Generate with: openssl rand -hex 32
AI_MEMORY_AUTH_TOKEN=<root-bearer>                       # machine admin; never leaves the host
ACTOR_PROXY_BEARER_TOKEN=<proxy-bearer>                  # DISTINCT from the root bearer
HOOK_AUTH_TOKEN=<hook-bearer>                            # static hook credential (or use per-consumer amk_ keys)
ENGINE_AUTH_TOKEN=<read-token-for-git-mirror>            # git-mirror reads page bodies with it
AI_MEMORY_AUTH__TOKEN_PEPPER=<hex-64>                    # seals native aim_ credentials — NEVER rotate
AI_MEMORY_AUTH__RECOVERY_TOKEN=<hex-64>                  # root password recovery
AI_MEMORY_AUTH__TRUSTED_PROXY_CIDRS=<caddy-container-ip>/32
ENGINE_INTERNAL_HOST=<hostname>
# INITIAL_ROOT_PASSWORD=<one-time>                       # first boot only; delete after the root logs in

# Providers
LLM_API_KEY=<llm-gateway-key>
OPENAI_API_KEY=<embeddings-key>                          # or EMBEDDING_API_KEY (>=1.34) to keep vendors separate

# Auto-improve (background LLM reviewer). REQUIRE_APPROVAL=true stages proposals for `ai-memory pending-writes`.
AI_MEMORY_AUTO_IMPROVE__SCHEDULER__ENABLED=true
AI_MEMORY_AUTO_IMPROVE__REQUIRE_APPROVAL=false
