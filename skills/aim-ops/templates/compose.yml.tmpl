# ai-memory instance — Docker Compose. Loopback-only; the tunnel/reverse proxy is the only ingress.
# Fill <placeholders>; pin every image BY DIGEST after verifying `--version` (see aim-ops upgrade).
services:
  ai-memory:
    image: ghcr.io/<ops-repo>/ai-memory@sha256:<engine-digest>
    restart: unless-stopped
    logging: { driver: json-file, options: { max-size: "10m", max-file: "3" } }
    env_file: [.env]
    environment:
      AI_MEMORY_DATA_DIR: /data
      AI_MEMORY_IN_CONTAINER: "1"
      AI_MEMORY_WEB_SLUG: /
      AI_MEMORY_ALLOWED_HOSTS: <hostname>,localhost,127.0.0.1,::1
      AI_MEMORY_AUTH__ROOT_USERNAME: <root-username>
      AI_MEMORY_AUTH__ROOT_ISSUER: https://<hostname>/keys-only      # pair with ROOT_SUBJECT (both or neither)
      AI_MEMORY_AUTH__ROOT_SUBJECT: operator:<root-username>
      AI_MEMORY_AUTH__SECURE_COOKIE: "true"
      AI_MEMORY_AUTH__TRUSTED_PROXY_CIDRS: ${AI_MEMORY_AUTH__TRUSTED_PROXY_CIDRS}   # caddy container IP/32
      AI_MEMORY_AUTH__RECOVERY_TOKEN: ${AI_MEMORY_AUTH__RECOVERY_TOKEN}
      AI_MEMORY_AUTH__TOKEN_PEPPER: ${AI_MEMORY_AUTH__TOKEN_PEPPER}
      AI_MEMORY_AUTH__ACTOR_PROXY_BEARER_TOKEN: ${ACTOR_PROXY_BEARER_TOKEN}       # MUST differ from AI_MEMORY_AUTH_TOKEN
      # AI_MEMORY_AUTH__INITIAL_ROOT_PASSWORD: ${INITIAL_ROOT_PASSWORD}          # first boot only; remove after login
      AI_MEMORY_AUTO_SCOPE__MODE: per_actor
      AI_MEMORY_ROUTING__MID_SESSION: sticky
      AI_MEMORY_DECAY__HARD_DELETE_AFTER_DAYS: "365"
      # Providers — set EXPLICITLY (2.0+: unset embedding provider = bundled English-only local model)
      AI_MEMORY_EMBEDDING_PROVIDER: openai              # openai | openai-compat | voyage | gemini | local | none
      AI_MEMORY_EMBEDDING_MODEL: "<embedding-model>"    # e.g. @cf/baai/bge-m3, text-embedding-3-large, bge-m3
      AI_MEMORY_EMBEDDING_DIM: "<dim>"                  # 1024 / 3072 / 384
      AI_MEMORY_EMBEDDING_BASE_URL: "<embedding-base-url>"
      AI_MEMORY_LLM_PROVIDER: openai-compat             # or anthropic | openai | gemini | copilot; empty = zero-LLM
      AI_MEMORY_LLM_MODEL: "<llm-model>"
      AI_MEMORY_LLM_BASE_URL: <llm-base-url>
      AI_MEMORY_ADMISSION_WEBHOOKS_JSON: >-
        [{"name":"scope-guard","blocking":true,"url":"http://scope-guard:8080/admit","events":["write_page","consolidate","delete","purge_project","move_project","purge_workspace","move_session"]},
         {"name":"contributors","blocking":false,"url":"http://contributors:8080/enrich","events":["write_page","consolidate"]},
         {"name":"git-mirror","blocking":false,"url":"http://git-mirror:8080/sync","events":["write_page","consolidate","delete","purge_project","move_session"]}]
      RUST_LOG: ai_memory=info,ai_memory_web=info,ai_memory_mcp=info
    volumes: ["./data:/data"]
    ports: ["127.0.0.1:49374:49374"]
    user: "1000:1000"
    command: ["serve","--transport","http","--bind","0.0.0.0:49374","--workspace","default","--project","notes","--enable-web","--web-ui-dir","/web-ui"]

  mcp-auth:
    image: ghcr.io/<ops-repo>/mcp-auth@sha256:<mcp-auth-digest>
    restart: unless-stopped
    logging: { driver: json-file, options: { max-size: "10m", max-file: "3" } }
    environment:
      KEYS_DB: /data/keys.db                      # keys-only mode (no OIDC_ISSUER)
      ACTOR_PROXY_BEARER_TOKEN: ${ACTOR_PROXY_BEARER_TOKEN}
      UPSTREAM_AUTH_TOKEN: ${ACTOR_PROXY_BEARER_TOKEN}
      HOOK_AUTH_TOKEN: ${HOOK_AUTH_TOKEN}
      HOOK_AUTH_USERNAME: <root-username>          # must be an ACL-allowed user (scope-guard)
      PASSTHROUGH_UNKNOWN_BEARER: "0"
      ENGINE_INTERNAL_URL: http://ai-memory:49374
      ENGINE_INTERNAL_HOST: ${ENGINE_INTERNAL_HOST}   # a host present in AI_MEMORY_ALLOWED_HOSTS
      # OIDC_ISSUER: https://<idp>/realms/<realm>      # only for a Keycloak-gated instance
    volumes:
      - mcp-auth-keys:/data

  caddy:
    image: docker.io/library/caddy@sha256:<caddy-digest>
    restart: unless-stopped
    logging: { driver: json-file, options: { max-size: "10m", max-file: "3" } }
    depends_on: [ai-memory, mcp-auth]
    ports: ["127.0.0.1:8080:8080"]
    volumes: ["./Caddyfile:/etc/caddy/Caddyfile:ro"]

  scope-guard:
    image: ghcr.io/<ops-repo>/scope-guard@sha256:<scope-guard-digest>
    restart: unless-stopped
    logging: { driver: json-file, options: { max-size: "10m", max-file: "3" } }
    environment:
      LISTEN_ADDR: 0.0.0.0:8080
      LOG_LEVEL: info
      ACL_RULES: '{"":[{"ops":["consolidate","delete"],"project":".*","workspace":".*"}],"<root-username>":[{"project":".*","workspace":".*"}]}'

  contributors:
    image: ghcr.io/<ops-repo>/contributors@sha256:<contributors-digest>
    restart: unless-stopped
    logging: { driver: json-file, options: { max-size: "10m", max-file: "3" } }
    environment: { LISTEN_ADDR: 0.0.0.0:8080, LOG_LEVEL: info }

  git-mirror:
    image: ghcr.io/<ops-repo>/git-mirror@sha256:<git-mirror-digest>
    restart: unless-stopped
    logging: { driver: json-file, options: { max-size: "10m", max-file: "3" } }
    env_file: [.env]
    environment:
      LISTEN_ADDR: 0.0.0.0:8080
      LOG_LEVEL: info
      REPO_URL: git@github.com:<org>/<wiki-backup-repo>.git
      REPO_BRANCH: main
      GIT_USER: ai-memory git-mirror
      GIT_EMAIL: git-mirror@<hostname>
      WORK_DIR: /work/repo
      ENGINE_URL: http://ai-memory:49374
      ENGINE_HOST_HEADER: localhost
      PUSH_DEBOUNCE: 10s
      RECONCILE_INTERVAL: 1h
      STALE_FAIL_THRESHOLD: 15m
      GIT_SSH_COMMAND: ssh -i /etc/git-ssh/id_ed25519 -o IdentitiesOnly=yes -o UserKnownHostsFile=/etc/git-ssh/known_hosts
    volumes:
      - "./git-work:/work"
      - "./git-ssh:/etc/git-ssh:ro"

volumes:
  mcp-auth-keys:
